# ─────────────────────────────────────────────────────────────────────────────
#  AI Trip Planner — Environment Variables
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Free at console.groq.com — no credit card needed (14,400 req/day)
GROQ_API_KEY=gsk_your_groq_key_here

# ── RECOMMENDED (free) ────────────────────────────────────────────────────────
# Free at app.tavily.com — 1,000 searches/month
# Powers: real places data, restaurant search, hotel search, event detection
TAVILY_API_KEY=tvly_your_tavily_key_here

# Free at openweathermap.org — 1,000 calls/day, no credit card
# Powers: live weather panel + weather-aware day scheduling
OPENWEATHER_API_KEY=your_openweather_key_here

# ── EMAIL ALERTS (Gmail SMTP) ─────────────────────────────────────────────────
# Use YOUR OWN Gmail address as the sender
GMAIL_SENDER=yourgmail@gmail.com

# App Password — NOT your regular Gmail password
# How to get it (5 minutes):
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification → turn ON (required)
#   3. Security → App Passwords
#   4. Select app: Mail | Device: Other → type "Trip Planner" → Generate
#   5. Copy the 16-character code shown (spaces are fine, we strip them)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── NO OTHER KEYS NEEDED ──────────────────────────────────────────────────────
# Currency conversion: open.er-api.com (completely free, no key)
# Images: Unsplash source URLs (completely free, no key)
# Maps links: Google Maps search links (no API key needed)

# ── OPTIONAL — Better images (free at pexels.com/api) ────────────────────────
# Without this: Picsum Photos used (free, consistent, no key needed)
# With this: real travel photos matched to each place/hotel/restaurant
# Free tier: 200 requests/hour
PEXELS_API_KEY=your_pexels_key_here
